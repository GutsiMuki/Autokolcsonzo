@using Autokolcsonzo.Models
@model Ugyfel

<form method="post" asp-action="UjUgyfel" asp-controller="Ugyfel"> 
    <label for="Nev">Név:</label>
    <input type="text" id="Nev" asp-for="Nev" required /><br>

    <label for="Email">Email:</label>
    <input type="email" id="Email" asp-for="Email" required /><br>

    <input type="submit" value="Hozzáadás" />
</form>
